{
  "about": "Pay-rule ground truth, worked out by hand from the agreement terms before the engine was written. Amounts in cents. Default terms: $35.00/h, 240 booked person-minutes (price $140.00), 24 h notice, late-cancel fee 50%, lock-out fee 100%, 30 min extra-time allowance (hold $157.50), extra time billed in whole 15-minute steps, cooperative share 5% rounded down. The hold is placed 10 minutes before the notice window opens. Member shares split by minutes worked (or equally for a cancellation fee), largest remainder, ties to the earlier member.",
  "defaults": {
    "rateCentsPerHour": 3500,
    "bookedMinutes": 240,
    "noticeHours": 24,
    "lateCancelPct": 50,
    "lockoutPct": 100,
    "extraAllowanceMinutes": 30,
    "extraStepMinutes": 15,
    "coopShareBps": 500,
    "holdLeadMinutes": 10
  },
  "cases": [
    { "id": 1, "title": "Completed on time", "event": { "type": "checkout", "worked": { "M1": 240 }, "extraApproved": false },
      "expect": { "holdCents": 15750, "captureCents": 14000, "releaseCents": 1750, "coopCents": 700, "members": { "M1": 13300 }, "dueCents": 0 } },
    { "id": 2, "title": "15 extra minutes, approved", "event": { "type": "checkout", "worked": { "M1": 255 }, "extraApproved": true },
      "expect": { "holdCents": 15750, "captureCents": 14875, "releaseCents": 875, "coopCents": 743, "members": { "M1": 14132 }, "dueCents": 0 } },
    { "id": 3, "title": "30 extra minutes, approved: the whole allowance", "event": { "type": "checkout", "worked": { "M1": 270 }, "extraApproved": true },
      "expect": { "holdCents": 15750, "captureCents": 15750, "releaseCents": 0, "coopCents": 787, "members": { "M1": 14963 }, "dueCents": 0 } },
    { "id": 4, "title": "60 extra minutes, approved: capped at the allowance", "event": { "type": "checkout", "worked": { "M1": 300 }, "extraApproved": true },
      "expect": { "holdCents": 15750, "captureCents": 15750, "releaseCents": 0, "coopCents": 787, "members": { "M1": 14963 }, "dueCents": 0 } },
    { "id": 5, "title": "60 extra minutes, not approved", "event": { "type": "checkout", "worked": { "M1": 300 }, "extraApproved": false },
