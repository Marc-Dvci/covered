{
  "name": "Covered",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "postCreateCommand": "npm ci --no-audit --no-fund && npm run build",
  "postStartCommand": "nohup bash -c 'npm start > /tmp/covered.log 2>&1 &'",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Covered demo",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
