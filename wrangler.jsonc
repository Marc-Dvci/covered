// The API Worker: D1 ledger, Workflows for the money steps, cron for the sweep. No public address of its own:
// the Pages project in deploy/pages forwards /api/* to it through a service binding.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "covered-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "workflows": [{ "name": "covered-money", "binding": "TASKS", "class_name": "MoneyTask" }],
  "d1_databases": [{ "binding": "DB", "database_name": "covered", "database_id": "REPLACED_AT_DEPLOY" }],
  "vars": {
    "COVERED_DEMO": "1",
    "COVERED_AI_UNTIL": "2026-12-21",
    "COVERED_MODEL_MAIN": "gemini-3.6-flash",
    "COVERED_MODEL_LIGHT": "gemini-3.5-flash-lite",
    "COVERED_MODEL_FALLBACKS": "gemini-3.5-flash,gemini-3-flash-preview"
  }
}
