{
  "plugins": ["typescript", "unicorn", "react", "oxc"],
  "rules": {
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/refs": "off"
  }
}
