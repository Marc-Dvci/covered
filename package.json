{
  "name": "covered",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/main.ts\" \"vite\"",
    "start": "node --no-warnings --import tsx server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --react-plugin --ignore-pattern \"dist/**\" --ignore-pattern \"web/public/_worker.js\" server shared web/src worker tests scripts eval probe",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx eval/run.ts",
    "e2e": "playwright test",
    "deploy": "wrangler deploy && npm run build && cd deploy/pages && wrangler pages deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bryntum/core-enterprise": "8.0.0",
    "@bryntum/scheduler-enterprise": "8.0.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "fast-check": "^4.10.2",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "description": "A cleaning cooperative's week on one board: PayPal holds each visit's pay a day ahead, and whoever does the visit is paid at check-out."
}
