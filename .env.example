# Everything is optional: with no keys, Covered runs on a deterministic PayPal stand-in and recorded model answers.

# PayPal sandbox REST app with Vault, Payouts and Transaction Search enabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Webhook id from the app's webhook settings; deliveries are verified against it, and refused without it
PAYPAL_WEBHOOK_ID=
# A sandbox payment token the demo households use for their holds
COVERED_DEMO_VAULT_ID=
# Routes the fictional members' pay to a sandbox receiver, e.g. *=PAYPAL:receiver@personal.example.com
COVERED_SANDBOX_PAYOUTS=

# Gemini API key (Google AI Studio). Free tier: make the key in a project with no billing account.
GEMINI_API_KEY=
COVERED_MODEL_MAIN=gemini-3.6-flash
COVERED_MODEL_LIGHT=gemini-3.5-flash-lite
COVERED_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3-flash-preview
COVERED_MODEL_TIMEOUT_S=20
COVERED_AI_UNTIL=2026-12-21
COVERED_AI_DAILY_CALLS=600
# 1 writes new model answers into data/ai-recordings.json (local only)
COVERED_RECORD=

# A SQLite file under the project, or "memory"
COVERED_DB_FILE=var/covered.db
COVERED_PUBLIC_URL=http://localhost:8787
COVERED_LINK_SECRET=change-me
PORT=8787

# The demo clock and reset controls; 0 turns them off
COVERED_DEMO=1
# After this long with no writes, the next visitor gets a fresh week
COVERED_DEMO_IDLE_MINUTES=30
# Each reset places real sandbox holds, so the number per day is capped
COVERED_DEMO_RESETS_PER_DAY=60

# Scripts only: the deployment that scripts/walk.ts, durability.ts and self-attack.ts run against
LIVE_URL=
# probe/probe.ts only, read from probe/.env: its sandbox payment token and payout receivers
PROBE_VAULT_ID=
PROBE_PAYOUT_EMAIL=
PROBE_VENMO_PHONE=
