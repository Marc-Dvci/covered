# Everything is optional: with no keys, Covered runs on a deterministic PayPal stand-in and recorded model answers.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Gemini API key (Google AI Studio). Free tier: make the key in a project with no billing account.
GEMINI_API_KEY=
COVERED_MODEL_MAIN=gemini-3.8-flash
COVERED_MODEL_LIGHT=gemini-3.5-flash-lite
COVERED_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3-flash-preview
COVERED_AI_UNTIL=2026-12-21
COVERED_AI_DAILY_CALLS=600
# Postgres URL in production; empty means an embedded Postgres (PGlite) under var/
DATABASE_URL=
COVERED_PUBLIC_URL=http://localhost:8787
COVERED_DEMO=1
COVERED_LINK_SECRET=change-me
# Render Workflows: empty runs tasks in-process
RENDER_API_KEY=
COVERED_WORKFLOW_SLUG=covered-workflows
