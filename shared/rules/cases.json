    { "id": 26, "title": "Seattle minimum rate $21.30/h, 3 hours", "terms": { "rateCentsPerHour": 2130, "bookedMinutes": 180 }, "event": { "type": "checkout", "worked": { "M1": 180 }, "extraApproved": false },
